# Public Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public Supabase anonymous key for client-side requests.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Private Supabase service role key for server-side jobs.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional Google PageSpeed Insights API key.
PAGESPEED_API_KEY="your-pagespeed-api-key"

# Optional Anthropic API key for AI report generation.
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Canonical application URL.
APP_URL="http://localhost:3000"
